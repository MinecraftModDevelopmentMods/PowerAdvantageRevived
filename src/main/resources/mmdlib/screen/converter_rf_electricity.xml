<screen xmlns="https://moddev.zone/mmdlib/screen"
        title="block.poweradvantage.converter_rf_electricity"
        block-entity="zone.moddev.mc.poweradvantage.power.ElectricityConverterBlockEntity"
        inventory="none">
  <vbox padding="8" spacing="5" align="center">
    <label text="screen.poweradvantage.converter_fe" text-fallback="FE / RF"/>
    <gauge id="fe" orientation="horizontal" length="8s" color="#DCA92B"
           value="#screenFe" max="#screenFeCapacity"
           tooltip="screen.poweradvantage.energy_amount" tooltip-fallback="{value} / {max} FE"/>
    <label text="screen.poweradvantage.converter_electricity" text-fallback="PA electricity"/>
    <gauge id="electricity" orientation="horizontal" length="8s" color="#5396E0"
           value="#screenElectricity" max="#screenElectricityCapacity"
           tooltip="screen.poweradvantage.electricity_amount" tooltip-fallback="{value} / {max} electricity units"/>
  </vbox>
</screen>
