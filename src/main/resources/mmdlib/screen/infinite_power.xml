<screen xmlns="https://moddev.zone/mmdlib/screen"
        title="block.poweradvantage.infinite_power"
        block-entity="zone.moddev.mc.poweradvantage.tiles.MachineBlockEntity"
        inventory="none">
  <vbox padding="8" spacing="5" align="center">
    <label text="screen.poweradvantage.energy" text-fallback="Energy"/>
    <gauge id="energy" orientation="horizontal" length="8s" color="#DCA92B"
           value="#screenStoredEnergy" max="#screenCapacity"
           tooltip="screen.poweradvantage.energy_amount"
           tooltip-fallback="{value} / {max} FE"/>
  </vbox>
</screen>
