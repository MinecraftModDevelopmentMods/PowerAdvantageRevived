<!--
  Discharge Grate: every 10 ticks pulls fluid from every neighbour and places one bucket of it in the world below
  (WorldFluidPump.Discharge).

  The fluid storage ID is "Fluids", the key 3.0 and 3.1 saved it under, so grates in those worlds keep their contents.
-->
<machine xmlns="https://moddev.zone/mmdlib/machine" version="1"
         extends="mmdlib:base_machine" name="Discharge Grate">
  <block hardness="1.5"/>
  <appearance preset="model" model="poweradvantage:block/machine/fluid_discharge"/>
  <storage>
    <fluids id="Fluids">
      <tank id="contents" capacity="1000" role="storage"/>
    </fluids>
  </storage>
  <processor id="discharge" class="zone.moddev.mc.poweradvantage.machine.WorldFluidPump$Discharge"/>
  <screen xmlns="https://moddev.zone/mmdlib/screen">
    <fill name="machine"/>
  </screen>
</machine>
